datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum RoleScopeLevel {
  SYSTEM
  ORGANIZATION
  ALL_PLANTS
  OWN_PLANT
  OWN_DEPARTMENT
  OWN_AREA
  OWN_RECORDS
  ASSIGNED_RECORDS
}

enum DocumentClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  REGULATORY_RESTRICTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkflowStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum WorkflowTaskStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  DELEGATED
  ESCALATED
}

enum HiraStatus {
  DRAFT
  IN_PROGRESS
  TEAM_REVIEW
  APPROVAL_PENDING
  APPROVED
  ACTIVE
  ARCHIVED
}

enum HiraReviewDecision {
  RECOMMENDED
  REWORK_REQUIRED
  REJECTED
}

enum HiraApprovalDecision {
  APPROVED
  REJECTED
  OVERRIDDEN
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum ControlHierarchyType {
  ELIMINATION
  SUBSTITUTION
  ENGINEERING
  ADMINISTRATIVE
  PPE
}

enum HazardCategory {
  CHEMICAL
  MECHANICAL
  ELECTRICAL
  THERMAL
  ERGONOMIC
  BIOLOGICAL
  RADIATION
  ENVIRONMENTAL
  PSYCHOSOCIAL
  PHYSICAL
}

// ==============================================================================
// 1. MULTI-TENANCY & GEOGRAPHIC HIERARCHY
// ==============================================================================


enum IncidentType {
  NEAR_MISS
  FIRST_AID
  MEDICAL_TREATMENT
  LOST_TIME_INJURY
  FATALITY
  PROPERTY_DAMAGE
  ENVIRONMENTAL_RELEASE
  FIRE
  EXPLOSION
  SPILL
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  CATASTROPHIC
}

enum IncidentStatus {
  DRAFT
  REPORTED
  CLASSIFIED
  INVESTIGATING
  RCA_INITIATED
  CAPA_LINKED
  PENDING_CLOSURE
  CLOSED
  STATUTORY_FILED
}

enum RcaStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  CLOSED
}

enum RcaMethodology {
  FIVE_WHY
  FISHBONE
  FAULT_TREE
  BOW_TIE
}

enum CapaStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED
  CLOSED
  OVERDUE
}

enum CapaPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CapaType {
  CORRECTIVE
  PREVENTIVE
}

enum PtwStatus {
  DRAFT
  SUBMITTED
  SAFETY_REVIEWED
  APPROVED
  ACTIVE
  SUSPENDED
  CLOSED
  REJECTED
}

enum PtwCategory {
  HOT_WORK
  CONFINED_SPACE
  ELECTRICAL
  WORKING_AT_HEIGHT
  EXCAVATION
  CHEMICAL
  RADIATION
  GENERAL
}
model Organization {
  incidents         Incident[]
  rcaStudies        RcaStudy[]
  capaRecords       CapaRecord[]
  permitsToWork     PermitToWork[]
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  legalName   String?
  slug        String   @unique
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  plants                  Plant[]
  users                   User[]
  employees               Employee[]
  roles                   Role[]
  auditLogs               AuditLog[]
  documents               Document[]
  workflowDefinitions     WorkflowDefinition[]
  workflowInstances       WorkflowInstance[]
  outboxEvents            OutboxEvent[]
  userRoles               UserRole[]
  hiraStudies             HiraStudy[]

  @@index([code])
  @@index([isActive])
}

model Plant {
  incidents         Incident[]
  rcaStudies        RcaStudy[]
  capaRecords       CapaRecord[]
  permitsToWork     PermitToWork[]
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  address        String?
  city           String?
  state          String?
  country        String?
  timezone       String       @default("UTC")
  isActive       Boolean      @default(true)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  departments    Department[]
  employees      Employee[]
  auditLogs      AuditLog[]
  documents      Document[]
  userRoles      UserRole[]
  hiraStudies    HiraStudy[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
}

model Department {
  incidents         Incident[]
  capaRecords       CapaRecord[]
  permitsToWork     PermitToWork[]
  id             String       @id @default(uuid())
  organizationId String
  plantId        String
  code           String
  name           String
  headEmployeeId String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  // Relations
  plant          Plant        @relation(fields: [plantId], references: [id], onDelete: Restrict)
  areas          Area[]
  employees      Employee[]
  userRoles      UserRole[]
  hiraStudies    HiraStudy[]

  @@unique([plantId, code])
  @@index([organizationId])
  @@index([plantId])
  @@index([isActive])
}

model Area {
  incidents         Incident[]
  id             String       @id @default(uuid())
  organizationId String
  plantId        String
  departmentId   String
  code           String
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  // Relations
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  hiraStudies    HiraStudy[]

  @@unique([departmentId, code])
  @@index([plantId])
  @@index([departmentId])
}

// ==============================================================================
// 2. IDENTITY & PEOPLE
// ==============================================================================

model User {
  reportedIncidents Incident[] @relation("IncidentReporter")
  investigatedIncidents Incident[] @relation("IncidentInvestigator")
  ledRcaStudies     RcaStudy[] @relation("RcaLeadInvestigator")
  assignedCapas     CapaRecord[] @relation("CapaAssignee")
  createdCapas      CapaRecord[] @relation("CapaCreator")
  capaTasksAssigned CapaTask[] @relation("CapaTaskAssignee")
  capaVerifications CapaVerification[] @relation("CapaVerifier")
  requestedPermits  PermitToWork[] @relation("PtwRequester")
  id              String       @id @default(uuid())
  organizationId  String
  email           String       @unique
  passwordHash    String
  firstName       String
  lastName        String
  phoneNumber     String?
  status          UserStatus   @default(ACTIVE)
  isMfaEnabled    Boolean      @default(false)
  lastLoginAt     DateTime?
  passwordChangedAt DateTime   @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  // Relations
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee                Employee?
  sessions                Session[]
  userRoles               UserRole[]
  auditLogs               AuditLog[]
  uploadedDocuments       Document[]
  assignedTasks           WorkflowTask[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  ledHiraStudies          HiraStudy[]               @relation("HiraLeader")
  createdHiraStudies      HiraStudy[]               @relation("HiraCreator")
  hiraTeamMembers         HiraTeamMember[]
  hiraReviews             HiraReview[]
  hiraApprovals           HiraApproval[]

  @@index([organizationId])
  @@index([email])
  @@index([status])
}

model Employee {
  id              String       @id @default(uuid())
  organizationId  String
  plantId         String
  departmentId    String
  userId          String?      @unique
  employeeCode    String
  designation     String
  isContractor    Boolean      @default(false)
  contractorAgency String?
  supervisorId    String?
  emergencyContact Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plant           Plant        @relation(fields: [plantId], references: [id], onDelete: Restrict)
  department      Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  supervisor      Employee?    @relation("SupervisorHierarchy", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates    Employee[]   @relation("SupervisorHierarchy")

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([plantId])
  @@index([departmentId])
  @@index([isContractor])
}

model Session {
  id              String       @id @default(uuid())
  userId          String
  refreshTokenHash String      @unique
  ipAddress       String?
  userAgent       String?
  deviceInfo      Json?
  isRevoked       Boolean      @default(false)
  revokedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([isRevoked])
  @@index([expiresAt])
}

// ==============================================================================
// 3. RBAC & PERMISSIONS
// ==============================================================================

model Role {
  id              String         @id @default(uuid())
  organizationId  String?        // Null for system-wide predefined standard roles
  code            String
  name            String
  description     String?
  scopeLevel      RoleScopeLevel @default(OWN_PLANT)
  isSystem        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, code])
  @@index([code])
}

model Permission {
  id          String   @id @default(uuid())
  module      String   // e.g., HIRA, INCIDENT, CAPA, PTW, ADMIN
  action      String   // e.g., CREATE, READ, APPROVE
  code        String   @unique // e.g., HIRA.APPROVE
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@index([code])
}

model RolePermission {
  id           String      @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime    @default(now())

  // Relations
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id              String         @id @default(uuid())
  userId          String
  roleId          String
  organizationId  String
  plantId         String?        // Scoped plant (optional if ALL_PLANTS/SYSTEM)
  departmentId    String?        // Scoped department (optional)
  scopeOverride   RoleScopeLevel?
  createdAt       DateTime       @default(now())

  // Relations
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plant           Plant?         @relation(fields: [plantId], references: [id], onDelete: SetNull)
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, organizationId, plantId, departmentId])
  @@index([userId])
  @@index([roleId])
  @@index([plantId])
}

// ==============================================================================
// 4. AUDIT & VERSIONING
// ==============================================================================

model AuditLog {
  id              String       @id @default(uuid())
  organizationId  String
  plantId         String?
  actorId         String
  action          String       // e.g., CREATE, UPDATE, APPROVE, CLOSE
  entityType      String       // e.g., HiraStudy, Incident, Capa, User
  entityId        String
  requestId       String?
  ipAddress       String?
  userAgent       String?
  beforeState     Json?
  afterState      Json?
  diff            Json?
  reason          String?
  metadata        Json?
  timestamp       DateTime     @default(now())

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plant           Plant?       @relation(fields: [plantId], references: [id], onDelete: Restrict)
  actor           User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([plantId])
  @@index([entityType, entityId])
  @@index([actorId, timestamp])
  @@index([timestamp])
}

model EntityVersion {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  version     Int
  snapshot    Json
  actorId     String
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ==============================================================================
// 5. DOCUMENTS
// ==============================================================================

model Document {
  id              String                 @id @default(uuid())
  organizationId  String
  plantId         String?
  uploadedById    String
  title           String
  fileName        String
  fileSize        Int
  mimeType        String
  storageKey      String                 // S3 object key or URI
  sha256Hash      String
  classification  DocumentClassification @default(INTERNAL)
  retentionYears  Int                    @default(7)
  isArchived      Boolean                @default(false)
  entityType      String?                // e.g., Incident, HIRA, CAPA
  entityId        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  // Relations
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plant           Plant?                 @relation(fields: [plantId], references: [id], onDelete: Restrict)
  uploadedBy      User                   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  versions        DocumentVersion[]

  @@index([organizationId])
  @@index([plantId])
  @@index([entityType, entityId])
  @@index([sha256Hash])
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  version     Int
  storageKey  String
  fileSize    Int
  sha256Hash  String
  uploadedById String
  changeNotes String?
  createdAt   DateTime @default(now())

  // Relations
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
}

// ==============================================================================
// 6. WORKFLOW ENGINE CORE
// ==============================================================================

model WorkflowDefinition {
  id              String             @id @default(uuid())
  organizationId  String
  code            String             // e.g., HIRA_APPROVAL_V1, INCIDENT_HIGH_SEVERITY
  name            String
  entityType      String             // e.g., HiraStudy, Incident, Capa
  version         Int                @default(1)
  isActive        Boolean            @default(true)
  definition      Json               // State machine definition, transitions, preconditions
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relations
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  steps           WorkflowStep[]
  instances       WorkflowInstance[]

  @@unique([organizationId, code, version])
  @@index([organizationId])
  @@index([entityType, isActive])
}

model WorkflowStep {
  id                   String             @id @default(uuid())
  workflowDefinitionId String
  stepKey              String             // e.g., DRAFT, CLASSIFIED, RCA, VERIFICATION
  name                 String
  sequenceOrder        Int
  requiredRoleCode     String?
  slaHours             Int?
  isTerminal           Boolean            @default(false)
  createdAt            DateTime           @default(now())

  // Relations
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)

  @@unique([workflowDefinitionId, stepKey])
  @@index([workflowDefinitionId, sequenceOrder])
}

model WorkflowInstance {
  id                   String             @id @default(uuid())
  organizationId       String
  workflowDefinitionId String
  entityType           String             // e.g., HiraStudy, Incident
  entityId             String
  currentState         String
  status               WorkflowStatus     @default(IN_PROGRESS)
  initiatedById        String
  startedAt            DateTime           @default(now())
  completedAt          DateTime?
  contextData          Json?              // Ephemeral workflow state data

  // Relations
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  tasks                WorkflowTask[]
  actions              WorkflowAction[]

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([status])
}

model WorkflowTask {
  id                 String             @id @default(uuid())
  workflowInstanceId String
  stepKey            String
  assignedToUserId   String?
  assignedRoleCode   String?
  status             WorkflowTaskStatus @default(PENDING)
  dueAt              DateTime?
  completedAt        DateTime?
  comments           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  workflowInstance   WorkflowInstance   @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  assignedToUser     User?              @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([workflowInstanceId])
  @@index([assignedToUserId, status])
  @@index([status, dueAt])
}

model WorkflowAction {
  id                 String           @id @default(uuid())
  workflowInstanceId String
  action             String           // e.g., SUBMIT, APPROVE, REJECT, CLOSE
  fromState          String
  toState            String
  actorId            String
  actorRoleCode      String?
  comments           String?
  payload            Json?
  timestamp          DateTime         @default(now())

  // Relations
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  @@index([workflowInstanceId])
  @@index([actorId, timestamp])
}

// ==============================================================================
// 7. NOTIFICATIONS & OUTBOX
// ==============================================================================

model Notification {
  id          String               @id @default(uuid())
  userId      String
  title       String
  message     String
  priority    NotificationPriority @default(MEDIUM)
  channel     NotificationChannel  @default(IN_APP)
  isRead      Boolean              @default(false)
  readAt      DateTime?
  linkUrl     String?
  entityType  String?
  entityId    String?
  createdAt   DateTime             @default(now())

  // Relations
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel
  category  String              // e.g., WORKFLOW_ASSIGNMENT, CAPA_OVERDUE, HIGH_INCIDENT
  isEnabled Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  // Relations
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
  @@index([userId])
}

model OutboxEvent {
  id             String       @id @default(uuid())
  organizationId String
  aggregateType  String       // e.g., INCIDENT, HIRA, CAPA
  aggregateId    String
  eventType      String       // e.g., INCIDENT_CREATED, HIRA_APPROVED
  payload        Json
  headers        Json?
  createdAt      DateTime     @default(now())
  processedAt    DateTime?
  retryCount     Int          @default(0)
  lastError      String?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([processedAt, createdAt])
  @@index([organizationId])
  @@index([aggregateType, aggregateId])
}

// ==============================================================================
// 8. HIRA DOMAIN (HAZARD IDENTIFICATION & RISK ASSESSMENT)
// ==============================================================================

model HiraStudy {
  id                         String              @id @default(uuid())
  organizationId             String
  plantId                    String
  departmentId               String
  areaId                     String?
  referenceNumber            String              // e.g. HIRA-2026-NW-0001
  title                      String
  description                String?
  version                    Int                 @default(1)
  status                     HiraStatus          @default(DRAFT)
  leaderId                   String
  createdById                String
  validUntil                 DateTime?
  submittedAt                DateTime?
  reviewedAt                 DateTime?
  approvedAt                 DateTime?
  activatedAt                DateTime?
  unacceptableRiskOverridden Boolean             @default(false)
  overrideJustification      String?
  overrideApprovedById       String?
  workflowInstanceId         String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  deletedAt                  DateTime?

  // Relations
  organization               Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plant                      Plant               @relation(fields: [plantId], references: [id], onDelete: Restrict)
  department                 Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  area                       Area?               @relation(fields: [areaId], references: [id], onDelete: SetNull)
  leader                     User                @relation("HiraLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  createdBy                  User                @relation("HiraCreator", fields: [createdById], references: [id], onDelete: Restrict)
  teamMembers                HiraTeamMember[]
  activities                 HiraActivity[]
  reviews                    HiraReview[]
  approvals                  HiraApproval[]
  versions                   HiraVersion[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId])
  @@index([plantId])
  @@index([departmentId])
  @@index([status])
  @@index([leaderId])
}

model HiraTeamMember {
  id             String     @id @default(uuid())
  hiraStudyId    String
  userId         String
  roleTitle      String     // e.g. FACILITATOR, PROCESS_ENGINEER, OPERATOR_REP
  departmentName String?
  createdAt      DateTime   @default(now())

  // Relations
  hiraStudy      HiraStudy  @relation(fields: [hiraStudyId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hiraStudyId, userId])
  @@index([hiraStudyId])
  @@index([userId])
}

model HiraActivity {
  id             String       @id @default(uuid())
  hiraStudyId    String
  activityName   String
  description    String?
  isRoutine      Boolean      @default(true)
  sequenceOrder  Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  hiraStudy      HiraStudy    @relation(fields: [hiraStudyId], references: [id], onDelete: Cascade)
  hazards        HiraHazard[]

  @@index([hiraStudyId, sequenceOrder])
}

model HiraHazard {
  id                  String             @id @default(uuid())
  activityId          String
  hazardCategory      HazardCategory     @default(PHYSICAL)
  hazardDescription   String
  consequence         String
  
  // Initial Risk (Severity x Likelihood)
  initialSeverity     Int                // 1 to 5
  initialLikelihood   Int                // 1 to 5
  initialRiskScore    Int                // 1 to 25
  initialRiskLevel    RiskLevel
  
  // Residual Risk (after controls)
  residualSeverity    Int                // 1 to 5
  residualLikelihood  Int                // 1 to 5
  residualRiskScore   Int                // 1 to 25 (minimum 1 floor)
  residualRiskLevel   RiskLevel
  
  alarpJustified      Boolean            @default(true)
  alarpJustification  String?
  isUnacceptable      Boolean            @default(false)
  requiresOverride    Boolean            @default(false)
  regulatoryReference String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relations
  activity            HiraActivity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  controls            HiraControl[]

  @@index([activityId])
  @@index([initialRiskLevel])
  @@index([residualRiskLevel])
}

model HiraControl {
  id                   String               @id @default(uuid())
  hazardId             String
  controlType          ControlHierarchyType
  description          String
  effectivenessPercent Int                  @default(0) // 0 to 100%
  isExisting           Boolean              @default(true)
  responsibleUserId    String?
  targetDate           DateTime?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Relations
  hazard               HiraHazard           @relation(fields: [hazardId], references: [id], onDelete: Cascade)

  @@index([hazardId])
  @@index([controlType])
}

model HiraReview {
  id             String              @id @default(uuid())
  hiraStudyId    String
  reviewerId     String
  decision       HiraReviewDecision
  comments       String
  reviewedAt     DateTime            @default(now())

  // Relations
  hiraStudy      HiraStudy           @relation(fields: [hiraStudyId], references: [id], onDelete: Cascade)
  reviewer       User                @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([hiraStudyId])
  @@index([reviewerId])
}

model HiraApproval {
  id             String                @id @default(uuid())
  hiraStudyId    String
  approverId     String
  decision       HiraApprovalDecision
  comments       String
  isOverride     Boolean               @default(false)
  approvedAt     DateTime              @default(now())

  // Relations
  hiraStudy      HiraStudy             @relation(fields: [hiraStudyId], references: [id], onDelete: Cascade)
  approver       User                  @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@index([hiraStudyId])
  @@index([approverId])
}

model HiraVersion {
  id             String     @id @default(uuid())
  hiraStudyId    String
  versionNumber  Int
  snapshot       Json
  changeReason   String?
  createdById    String
  createdAt      DateTime   @default(now())

  // Relations
  hiraStudy      HiraStudy  @relation(fields: [hiraStudyId], references: [id], onDelete: Cascade)

  @@unique([hiraStudyId, versionNumber])
  @@index([hiraStudyId])
}


// ==============================================================================
// 9. INCIDENT MANAGEMENT
// ==============================================================================

model Incident {
  id                  String           @id @default(uuid())
  organizationId      String
  plantId             String
  departmentId        String
  areaId              String?
  referenceNumber     String           // e.g. INC-2026-NW-0001
  title               String
  description         String
  incidentType        IncidentType
  severity            IncidentSeverity @default(MEDIUM)
  status              IncidentStatus   @default(DRAFT)
  incidentDate        DateTime
  incidentTime        String?          // HH:MM format
  location            String?
  reportedById        String
  investigatorId      String?
  classifiedById      String?
  closedById          String?
  rootCauseId         String?          // FK to RcaStudy
  workflowInstanceId  String?
  immediateActions    String?
  isStatutoryRequired Boolean          @default(false)
  statutoryFiledAt    DateTime?
  submittedAt         DateTime?
  classifiedAt        DateTime?
  investigationStartedAt DateTime?
  closedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  // Relations
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plant               Plant            @relation(fields: [plantId], references: [id], onDelete: Restrict)
  department          Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  area                Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)
  reportedBy          User             @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  investigator        User?            @relation("IncidentInvestigator", fields: [investigatorId], references: [id], onDelete: SetNull)
  injuries            IncidentInjury[]
  witnesses           IncidentWitness[]
  rcaStudies          RcaStudy[]
  capaRecords         CapaRecord[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId])
  @@index([plantId])
  @@index([departmentId])
  @@index([status])
  @@index([severity])
  @@index([incidentDate])
  @@index([reportedById])
}

model IncidentInjury {
  id              String   @id @default(uuid())
  incidentId      String
  personName      String
  employeeCode    String?
  bodyPart        String?
  injuryType      String
  medicalAttended Boolean  @default(false)
  hospitalName    String?
  createdAt       DateTime @default(now())

  incident        Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentWitness {
  id           String   @id @default(uuid())
  incidentId   String
  personName   String
  employeeCode String?
  statement    String?
  createdAt    DateTime @default(now())

  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

// ==============================================================================
// 10. ROOT CAUSE ANALYSIS (RCA)
// ==============================================================================

model RcaStudy {
  id              String         @id @default(uuid())
  organizationId  String
  plantId         String
  incidentId      String
  referenceNumber String         // e.g. RCA-2026-NW-0001
  title           String
  methodology     RcaMethodology @default(FIVE_WHY)
  status          RcaStatus      @default(DRAFT)
  leadInvestigatorId String
  rootCauseSummary   String?
  contributingFactors Json?
  systemicFactors    Json?
  workflowInstanceId String?
  approvedById       String?
  approvedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  // Relations
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plant           Plant          @relation(fields: [plantId], references: [id], onDelete: Restrict)
  incident        Incident       @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  leadInvestigator User          @relation("RcaLeadInvestigator", fields: [leadInvestigatorId], references: [id], onDelete: Restrict)
  findings        RcaFinding[]
  capaRecords     CapaRecord[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId])
  @@index([plantId])
  @@index([incidentId])
  @@index([status])
}

model RcaFinding {
  id           String    @id @default(uuid())
  rcaStudyId   String
  whyLevel     Int?      // For 5-Why: 1-5
  category     String?   // For Fishbone: Machine, Method, Man, Material, Measurement, Environment
  finding      String
  evidence     String?
  isRootCause  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rcaStudy     RcaStudy  @relation(fields: [rcaStudyId], references: [id], onDelete: Cascade)

  @@index([rcaStudyId])
}

// ==============================================================================
// 11. CAPA (CORRECTIVE AND PREVENTIVE ACTION)
// ==============================================================================

model CapaRecord {
  id              String       @id @default(uuid())
  organizationId  String
  plantId         String
  departmentId    String?
  referenceNumber String       // e.g. CAPA-2026-NW-0001
  title           String
  description     String
  capaType        CapaType     @default(CORRECTIVE)
  priority        CapaPriority @default(MEDIUM)
  status          CapaStatus   @default(OPEN)
  incidentId      String?
  rcaStudyId      String?
  assignedToId    String?
  verifiedById    String?
  closedById      String?
  workflowInstanceId String?
  targetDate      DateTime?
  dueDate         DateTime?
  assignedAt      DateTime?
  startedAt       DateTime?
  verifiedAt      DateTime?
  closedAt        DateTime?
  effectivenessRating Int?     // 1-5
  effectivenessNotes  String?
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plant           Plant        @relation(fields: [plantId], references: [id], onDelete: Restrict)
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  incident        Incident?    @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  rcaStudy        RcaStudy?    @relation(fields: [rcaStudyId], references: [id], onDelete: SetNull)
  assignedTo      User?        @relation("CapaAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy       User         @relation("CapaCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks           CapaTask[]
  verifications   CapaVerification[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId])
  @@index([plantId])
  @@index([status])
  @@index([assignedToId])
  @@index([targetDate])
}

model CapaTask {
  id           String     @id @default(uuid())
  capaId       String
  title        String
  description  String?
  assignedToId String?
  dueDate      DateTime?
  completedAt  DateTime?
  isComplete   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  capa         CapaRecord @relation(fields: [capaId], references: [id], onDelete: Cascade)
  assignedTo   User?      @relation("CapaTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([capaId])
}

model CapaVerification {
  id           String     @id @default(uuid())
  capaId       String
  verifiedById String
  verdict      String     // EFFECTIVE, PARTIALLY_EFFECTIVE, INEFFECTIVE
  notes        String
  verifiedAt   DateTime   @default(now())

  capa         CapaRecord @relation(fields: [capaId], references: [id], onDelete: Cascade)
  verifiedBy   User       @relation("CapaVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([capaId])
}

// ==============================================================================
// 12. PERMIT TO WORK (PTW)
// ==============================================================================

model PermitToWork {
  id                  String      @id @default(uuid())
  organizationId      String
  plantId             String
  departmentId        String
  areaId              String?
  referenceNumber     String      // e.g. PTW-2026-NW-0001
  title               String
  workDescription     String
  category            PtwCategory @default(GENERAL)
  status              PtwStatus   @default(DRAFT)
  requestedById       String
  safetyReviewerId    String?
  approvedById        String?
  closedById          String?
  workflowInstanceId  String?
  plannedStartDate    DateTime
  plannedEndDate      DateTime
  actualStartDate     DateTime?
  actualEndDate       DateTime?
  hazardsIdentified   String?
  precautions         String?
  emergencyProcedures String?
  ppeRequired         Json?       // Array of PPE items
  approvedAt          DateTime?
  closedAt            DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  // Relations
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plant               Plant        @relation(fields: [plantId], references: [id], onDelete: Restrict)
  department          Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  requestedBy         User         @relation("PtwRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  isolationPoints     PtwIsolationPoint[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId])
  @@index([plantId])
  @@index([status])
  @@index([category])
  @@index([plannedStartDate])
}

model PtwIsolationPoint {
  id            String       @id @default(uuid())
  permitId      String
  isolationType String       // ELECTRICAL, MECHANICAL, PROCESS, PNEUMATIC
  description   String
  location      String?
  isolatedById  String?
  isolatedAt    DateTime?
  reinstatedAt  DateTime?
  createdAt     DateTime     @default(now())

  permit        PermitToWork @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@index([permitId])
}
