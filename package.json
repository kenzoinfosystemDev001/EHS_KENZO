{
  "name": "kenzo-ehs",
  "version": "0.1.0",
  "private": true,
  "description": "Kenzo EHS — Enterprise Environment, Health & Safety Management Platform",
  "author": "Kenzo Infosystems Pvt Ltd",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && pnpm -r --filter=!@kenzo-ehs/mobile run build",
    "dev:api": "pnpm --filter @kenzo-ehs/api run start:dev",
    "dev:web": "pnpm --filter @kenzo-ehs/web run dev",
    "lint": "pnpm -r --filter=!@kenzo-ehs/mobile run lint",
    "typecheck": "pnpm -r --filter=!@kenzo-ehs/mobile run typecheck",
    "test": "pnpm -r --filter=!@kenzo-ehs/mobile run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rimraf \"**/node_modules\" \"**/dist\" \"**/.next\" \"**/.turbo\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "prettier": "^3.5.3",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
