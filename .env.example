# ==============================================================================
# KENZO EHS — Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_NAME=kenzo-ehs
API_PORT=4000
WEB_PORT=3000

# Base URLs
API_BASE_URL=http://localhost:4000/api/v1
WEB_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (System of Record)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kenzo_ehs?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (Job Queue & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_chars_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_min_32_chars_long
JWT_REFRESH_EXPIRATION=7d

# File Storage (S3-compatible: MinIO / AWS S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=kenzo-ehs-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Logging & Observability
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
